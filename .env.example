# Copy this file to .env and fill in real values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that accepts images and JSON output.
GEMINI_MODEL=gemini-flash-lite-latest
# Seconds before a model call is abandoned (the case then goes to pending_review).
GEMINI_TIMEOUT_S=90

# Tenants: org_id:api_key pairs, comma separated. Use long random keys in production.
ORG_KEYS=org_demo_alpha:change-me-alpha-key,org_demo_bravo:change-me-bravo-key

# Checks below this confidence are downgraded to UNCERTAIN.
MIN_CONFIDENCE=0.6

# Storage locations (defaults shown).
DB_PATH=storage/returns.db
IMAGE_DIR=storage/images
